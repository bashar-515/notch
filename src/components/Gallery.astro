---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";

type Props = { items: CollectionEntry<"articles">["data"]["gallery"] };

const { items } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/articles/**/*.{jpg,png,webp}",
  { eager: true },
);
---

<div
  class="group/gallery mt-8 flex flex-col items-center gap-4 data-open:fixed data-open:inset-0 data-open:z-50 data-open:mt-0 data-open:justify-center data-open:gap-6 data-open:bg-black data-open:p-8"
>
  <div
    data-frame
    tabindex="0"
    class="relative w-full cursor-none group-data-open/gallery:min-h-0 group-data-open/gallery:flex-1 focus:outline-none"
  >
    <div
      data-slides
      class="relative aspect-[7/5] group-data-open/gallery:aspect-auto group-data-open/gallery:h-full"
    >
      {
        items.map((item, i) => (
          <Image
            src={images[`../assets${item.image}`]!.default}
            alt=""
            width={1600}
            class:list={[
              "absolute inset-0 h-full w-full object-contain transition-opacity duration-700",
              i === 0 ? "opacity-100" : "opacity-0",
            ]}
          />
        ))
      }
    </div>

    <span
      data-cursor
      aria-hidden="true"
      hidden
      class="pointer-events-none absolute -translate-x-1/2 -translate-y-1/2 font-[system-ui] text-5xl select-none"
    >
      ▶
    </span>

    <button
      type="button"
      data-fullscreen
      aria-label="View fullscreen"
      class="absolute top-0 right-0 cursor-pointer p-3 opacity-0 transition-opacity duration-200 group-focus-within/gallery:opacity-100 group-hover/gallery:opacity-100 group-data-open/gallery:hidden"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="size-6"
      >
        <path d="M15 3h6v6M21 3l-7 7M9 21H3v-6M3 21l7-7"></path>
      </svg>
    </button>
  </div>

  {
    items.length > 1 && (
      <div class="flex gap-2 text-black opacity-0 transition-opacity duration-200 group-focus-within/gallery:opacity-100 group-hover/gallery:opacity-100 group-data-open/gallery:text-white">
        {items.map(() => (
          <button
            type="button"
            class="dot h-3 w-3 rounded-full border border-current [&:not(.bg-current)]:cursor-pointer"
          />
        ))}
      </div>
    )
  }

  {
    items.map((item, i) => (
      <p
        hidden={i !== 0}
        class="caption font-times text-center text-xl leading-tight text-black/75 group-data-open/gallery:hidden"
        set:html={item.caption ?? ""}
      />
    ))
  }
</div>

<script>
  const pageScroller = document.querySelector<HTMLElement>(
    "[data-pageScroller]",
  )!;

  const autoplay = !window.matchMedia("(prefers-reduced-motion: reduce)")
    .matches;

  document.querySelectorAll<HTMLElement>(".group\\/gallery").forEach((root) => {
    const frame = root.querySelector<HTMLElement>("[data-frame]");
    const scroller = root.querySelector<HTMLElement>("[data-slides]");
    const cursor = root.querySelector<HTMLElement>("[data-cursor]");
    const fullscreen = root.querySelector<HTMLElement>("[data-fullscreen]");
    if (!frame || !scroller || !cursor || !fullscreen) return;

    const count = scroller.children.length;
    const dots = [...root.querySelectorAll<HTMLElement>(".dot")];
    const captions = [...root.querySelectorAll<HTMLElement>(".caption")];
    let index = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const go = (delta: number) => {
      index = (index + count + delta) % count;
      [...scroller.children].forEach((slide, i) => {
        slide.classList.toggle("opacity-100", i === index);
        slide.classList.toggle("opacity-0", i !== index);
      });
      dots.forEach((dot, i) => dot.classList.toggle("bg-current", i === index));
      captions.forEach((caption, i) => (caption.hidden = i !== index));
      place(); // what's under the pointer may have changed
    };

    const stop = () => clearInterval(timer);
    const start = () => {
      stop();
      if (autoplay && count > 1) timer = setInterval(() => go(1), 5000);
    };

    type Point = { clientX: number; clientY: number };
    let pointer: Point | null = null;

    const isLeft = ({ clientX }: Point) => {
      const { left, width } = frame.getBoundingClientRect();
      return clientX - left < width / 2;
    };

    // In the overlay the frame is larger than the picture; only the picture itself is interactive.
    const overPicture = ({ clientX, clientY }: Point) => {
      if (!root.hasAttribute("data-open")) return true;
      const img = scroller.children[index] as HTMLImageElement;
      const box = img.getBoundingClientRect();
      if (!img.naturalWidth) return true;
      const scale = Math.min(
        box.width / img.naturalWidth,
        box.height / img.naturalHeight,
      );
      const w = img.naturalWidth * scale;
      const h = img.naturalHeight * scale;
      const x = clientX - (box.left + (box.width - w) / 2);
      const y = clientY - (box.top + (box.height - h) / 2);
      return x >= 0 && x <= w && y >= 0 && y <= h;
    };

    const within = ({ clientX, clientY }: Point, el: Element) => {
      const b = el.getBoundingClientRect();
      return (
        clientX >= b.left &&
        clientX <= b.right &&
        clientY >= b.top &&
        clientY <= b.bottom
      );
    };

    // Place the arrow under the real pointer, or hide it when the pointer isn't over the picture.
    // Autoplay pauses while the pointer is over the frame, whether it got there by moving or by scrolling.
    let hovering = false;
    const place = () => {
      const p = pointer;
      const over = !!p && within(p, frame);
      if (over !== hovering) {
        hovering = over;
        if (over) stop();
        else start();
      }
      if (!p || !over || within(p, fullscreen) || !overPicture(p)) {
        cursor.hidden = true;
        frame.classList.remove("cursor-none");
        return;
      }
      const { left, top } = frame.getBoundingClientRect();
      frame.classList.add("cursor-none");
      cursor.style.left = `${p.clientX - left}px`;
      cursor.style.top = `${p.clientY - top}px`;
      cursor.textContent = isLeft(p) ? "◀" : "▶";
      cursor.hidden = false;
    };

    window.addEventListener("pointermove", (event) => {
      pointer = { clientX: event.clientX, clientY: event.clientY };
      place();
    });
    window.addEventListener("scroll", place, { passive: true });
    pageScroller.addEventListener("scroll", place, { passive: true });
    window.addEventListener("resize", place);
    for (const img of scroller.querySelectorAll("img")) {
      img.addEventListener("load", place);
    }
    document.addEventListener("pointerleave", () => {
      pointer = null;
      place();
    });
    frame.addEventListener("click", (event) => {
      if (fullscreen.contains(event.target as Node) || !overPicture(event))
        return;
      go(isLeft(event) ? -1 : 1);
    });
    const setOpen = (open: boolean) => {
      root.toggleAttribute("data-open", open);
      document.body.classList.toggle("overflow-hidden", open);
      go(0);
    };
    fullscreen.addEventListener("click", () => setOpen(true));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && root.hasAttribute("data-open"))
        setOpen(false);
    });
    frame.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") go(-1);
      if (event.key === "ArrowRight") go(1);
    });

    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        if (i !== index) go(i - index);
        start();
      }),
    );

    dots[0]?.classList.add("bg-current");
    start();
  });
</script>
