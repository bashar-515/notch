---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Product } from "../types";

type Props = { product: Product; idx: number };

const { product, idx } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/{shop,donate,magazines}/**/*.{jpg,png}",
  { eager: true },
);

const covers = product.covers ?? [];
const slides = product.isIssue
  ? [...covers, ...[...product.images].sort()]
  : product.images;
---

<div
  class:list={[
    "flex gap-14 max-md:flex-col max-md:gap-6",
    idx % 2 === 1 && "flex-row-reverse",
  ]}
>
  <div class="flex flex-col md:grow md:gap-6 md:contain-size">
    <div
      data-scroll-fade
      class="flex flex-col gap-5 overflow-y-auto pb-1 [scrollbar-width:none] data-scrollable:mask-b-from-85% [&::-webkit-scrollbar]:hidden"
    >
      <h2 class="text-3xl leading-none font-medium max-md:text-4xl">
        {product.name}
      </h2>

      <p
        class="font-times text-xl leading-none whitespace-pre-line max-md:text-2xl"
      >
        <Fragment set:html={product.descriptionParagraphs.join("\n\n")} />
        {
          product.coverCredit && (
            <span class="italic">
              {"\n\n"}Cover photo by {product.coverCredit}.
            </span>
          )
        }
      </p>
    </div>
    <div
      class="mt-auto flex flex-col max-md:mt-18 max-md:flex-row max-md:items-center max-md:justify-end max-md:gap-3"
    >
      <p class="text-3xl leading-none font-medium max-md:text-4xl">
        {
          typeof product.price === "number"
            ? `$${product.price.toLocaleString("en-US")}`
            : product.price
        }
      </p>

      <a
        href={product.stripeUrl}
        class="font-times hover:text-primary border-primary bg-primary mt-3 mr-auto rounded-sm border px-3 py-1 text-xl text-white hover:bg-white max-md:mt-0 max-md:mr-0 max-md:py-2.5 max-md:text-2xl"
      >
        {product.buttonText ?? "buy now"}
      </a>
    </div>
  </div>

  <div
    class="group/carousel relative w-252 shrink-0 max-md:order-first max-md:w-full"
  >
    <div
      class:list={[
        "bg-tertiary flex snap-x snap-mandatory overflow-x-hidden rounded-sm [scrollbar-width:none] [&::-webkit-scrollbar]:hidden",
        product.isIssue ? "aspect-[5/3]" : "aspect-[15/8]",
        "max-md:aspect-[2/1]",
      ]}
    >
      {
        slides.map((image, i) =>
          product.isIssue ? (
            <div class="flex w-full shrink-0 snap-start items-center justify-center py-12 max-md:py-4">
              <div class="relative h-full">
                <Image
                  src={images[`../assets${image}`].default}
                  alt={product.name}
                  width={1600}
                  class:list={[
                    "h-full w-auto",
                    i < covers.length
                      ? i % 2
                        ? "shadow-cover-left"
                        : "shadow-cover-right"
                      : i % 2
                        ? "shadow-left"
                        : "shadow-right",
                  ]}
                />
                {i >= covers.length && (
                  <div
                    class:list={[
                      "pointer-events-none absolute inset-y-0 w-1/12",
                      i % 2
                        ? "right-1/2 bg-linear-to-l from-black/15 to-transparent"
                        : "left-1/2 bg-linear-to-r from-black/15 to-transparent",
                    ]}
                  />
                )}
              </div>
            </div>
          ) : (
            <Image
              src={images[`../assets${image}`].default}
              alt={product.name}
              width={1600}
              class="h-full w-full shrink-0 snap-start object-cover"
            />
          ),
        )
      }
    </div>

    {
      slides.length > 1 && (
        <>
          <button
            type="button"
            id={`prev-${idx}`}
            class="hover:text-secondary pointer-events-none absolute top-1/2 left-5 -translate-y-1/2 cursor-pointer font-[system-ui] text-5xl text-white opacity-0 transition-opacity duration-200 group-focus-within/carousel:opacity-100 group-hover/carousel:pointer-events-auto group-hover/carousel:opacity-100 max-md:pointer-events-auto max-md:opacity-100"
          >
            ◀
          </button>
          <button
            type="button"
            id={`next-${idx}`}
            class="hover:text-secondary pointer-events-none absolute top-1/2 right-5 -translate-y-1/2 cursor-pointer font-[system-ui] text-5xl text-white opacity-0 transition-opacity duration-200 group-focus-within/carousel:opacity-100 group-hover/carousel:pointer-events-auto group-hover/carousel:opacity-100 max-md:pointer-events-auto max-md:opacity-100"
          >
            ▶
          </button>
        </>
      )
    }

    <div
      class="pointer-events-none absolute bottom-5 left-1/2 flex -translate-x-1/2 gap-2 opacity-0 transition-opacity duration-200 group-focus-within/carousel:opacity-100 group-hover/carousel:pointer-events-auto group-hover/carousel:opacity-100 max-md:pointer-events-auto max-md:opacity-100"
    >
      {
        slides.map(() => (
          <button
            type="button"
            class="dot h-3 w-3 rounded-full border border-white [&:not(.bg-white)]:cursor-pointer"
          />
        ))
      }
    </div>
  </div>
</div>

<script>
  const autoplay = !window.matchMedia("(prefers-reduced-motion: reduce)")
    .matches;

  document
    .querySelectorAll<HTMLElement>(".group\\/carousel")
    .forEach((root, productIndex) => {
      const scroller = root.querySelector<HTMLElement>("div");
      const prev = document.getElementById(`prev-${productIndex}`);
      const next = document.getElementById(`next-${productIndex}`);
      if (!scroller) return;

      const count = scroller.children.length;
      const dots = [...root.querySelectorAll<HTMLElement>(".dot")];
      let index = 0;

      const go = (delta: number) => {
        index = (index + count + delta) % count;
        scroller.scrollTo({
          left: index * scroller.clientWidth,
          behavior: "instant",
        });
        dots.forEach((dot, i) => dot.classList.toggle("bg-white", i === index));
      };

      dots[0]?.classList.add("bg-white");

      let timer = autoplay ? setInterval(() => go(1), 5000) : undefined;

      const manual = (delta: number) => {
        clearInterval(timer);
        if (autoplay) timer = setInterval(() => go(1), 5000);
        go(delta);
      };

      prev?.addEventListener("click", () => manual(-1));
      next?.addEventListener("click", () => manual(1));

      dots.forEach((dot, i) =>
        dot.addEventListener("click", () => {
          if (i !== index) manual(i - index);
        }),
      );
    });

  const overflow = new ResizeObserver((entries) =>
    entries.forEach(({ target }) =>
      target.toggleAttribute(
        "data-scrollable",
        target.scrollHeight - target.clientHeight > 1,
      ),
    ),
  );
  document
    .querySelectorAll("[data-scroll-fade]")
    .forEach((box) => overflow.observe(box));
</script>
