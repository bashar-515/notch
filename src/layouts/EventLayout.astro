---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "./Layout.astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/events/*/{top,bottom}/*.{jpg,png}",
  { eager: true },
);

type Props = {
  title: string;
  name: string;
  heading: string;
  location: string;
  description: string;
  topImages: string[];
  bottomImages: string[];
};

const { title, name, heading, location, description, topImages, bottomImages } =
  Astro.props;
---

<Layout title={title}>
  <div
    class="flex flex-1 flex-col justify-between pt-8 pb-24 max-md:block max-md:pt-0 max-md:pb-0"
  >
    <div class="max-md:flex max-md:flex-col md:contents">
      <div
        class="max-md:flex max-md:h-svh max-md:flex-col max-md:justify-center max-md:overflow-x-auto max-md:overflow-y-hidden max-md:pt-24 max-md:[scrollbar-width:none] md:contents"
      >
        <div class="max-md:w-max md:contents">
          <div class="h-68 overflow-hidden max-md:h-64 max-md:overflow-visible">
            <div data-track class="flex h-full w-max gap-3">
              {
                topImages.map((image) => (
                  <Image
                    alt=""
                    src={images[`../assets${image}`]!.default}
                    loading="eager"
                    height={560}
                    class="h-full w-auto"
                  />
                ))
              }
            </div>
          </div>

          <div
            class="px-frame flex items-center justify-between py-8 max-md:contents"
          >
            <h1
              class="text-3xl leading-none tracking-tighter whitespace-pre max-md:sticky max-md:left-0 max-md:w-screen max-md:px-6 max-md:pt-6 max-md:pb-8 max-md:text-2xl"
            >
              {`${name}\n${heading}\n${location}`}
            </h1>

            <p
              class="font-times px-30 text-lg leading-none tracking-tight max-md:hidden"
            >
              {description}
            </p>

            <p
              class="ml-auto text-6xl leading-none select-none max-md:hidden"
              aria-hidden="true"
            >
              ➤
            </p>
          </div>

          <div class="h-68 overflow-hidden max-md:h-72 max-md:overflow-visible">
            <div data-track class="flex h-full w-max gap-3">
              {
                bottomImages.map((image) => (
                  <Image
                    alt=""
                    src={images[`../assets${image}`]!.default}
                    loading="eager"
                    height={560}
                    class="h-full w-auto"
                  />
                ))
              }

              <p
                class="font-times w-screen shrink-0 self-center px-6 text-2xl leading-none tracking-tight md:hidden"
              >
                {description}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  html {
    scrollbar-width: none;
  }

  html::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const scroller = document.querySelector<HTMLElement>("[data-scroller]")!;

  const tracks = [...document.querySelectorAll<HTMLElement>("[data-track]")];
  const desktop = matchMedia(
    `(width >= ${getComputedStyle(document.documentElement).getPropertyValue("--breakpoint-md")})`,
  ).matches;

  const overflow = (track: HTMLElement) =>
    track.offsetWidth - track.parentElement!.clientWidth;

  if (desktop) {
    let progress = 0.5;

    const apply = () => {
      if (progress < 1) {
        window.scrollTo(0, 0);
        scroller.scrollTo(0, 0);
      }

      for (const track of tracks) {
        track.style.transform = `translateX(${-progress * overflow(track)}px)`;
      }
    };

    apply();

    window.addEventListener(
      "wheel",
      (event) => {
        const down = event.deltaY > 0;
        const horizontal =
          window.scrollY + scroller.scrollTop < 1 &&
          (down ? progress < 1 : progress > 0);
        if (!horizontal) return;

        event.preventDefault();
        const distance = Math.max(...tracks.map(overflow));
        progress = Math.min(1, Math.max(0, progress + event.deltaY / distance));
        apply();
      },
      { passive: false },
    );

    const pin = () => {
      if (progress < 1 && window.scrollY + scroller.scrollTop > 0) {
        window.scrollTo(0, 0);
        scroller.scrollTo(0, 0);
      }
    };
    window.addEventListener("scroll", pin);
    scroller.addEventListener("scroll", pin);

    window.addEventListener("resize", apply);
  } else {
    const lag = () => {
      const widest = Math.max(...tracks.map((track) => track.offsetWidth));
      for (const track of tracks)
        track.style.setProperty("--lag", `${widest - track.offsetWidth}px`);
    };

    lag();
    window.addEventListener("resize", lag);
  }
</script>

<style>
  @media (width < 48rem) {
    [data-track] {
      --lag: 0px;
      animation: lag linear both;
    }

    @supports (animation-timeline: scroll()) {
      [data-track] {
        animation-timeline: scroll(nearest inline);
      }
    }

    @keyframes lag {
      to {
        translate: var(--lag) 0;
      }
    }
  }
</style>
