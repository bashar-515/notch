---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "./Layout.astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/events/*/{top,bottom}/*.{jpg,png}",
  { eager: true },
);

type Props = {
  title: string;
  name: string;
  heading: string;
  location: string;
  description: string;
  topImages: string[];
  bottomImages: string[];
};

const { title, name, heading, location, description, topImages, bottomImages } =
  Astro.props;
---

<Layout title={title}>
  <div class="flex flex-1 flex-col justify-between pt-8 pb-24">
    <div class="h-68 overflow-hidden">
      <div data-track class="px-frame flex h-full w-max gap-3">
        {
          topImages.map((image) => (
            <Image
              alt=""
              src={images[`../assets${image}`]!.default}
              loading="eager"
              height={560}
              class="h-full w-auto"
            />
          ))
        }
      </div>
    </div>

    <div class="px-frame flex items-center justify-between py-8">
      <h1 class="text-3xl leading-none tracking-tighter whitespace-pre">
        {`${name}\n${heading}\n${location}`}
      </h1>

      <p class="font-times px-30 text-lg leading-none tracking-tight">
        {description}
      </p>

      <p class="ml-auto text-6xl leading-none select-none" aria-hidden="true">
        ➤
      </p>
    </div>

    <div class="h-68 overflow-hidden">
      <div data-track class="px-frame flex h-full w-max gap-3">
        {
          bottomImages.map((image) => (
            <Image
              alt=""
              src={images[`../assets${image}`]!.default}
              loading="eager"
              height={560}
              class="h-full w-auto"
            />
          ))
        }
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  html {
    scrollbar-width: none;
  }

  html::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const scroller = document.querySelector<HTMLElement>("[data-scroller]")!;

  const tracks = [...document.querySelectorAll<HTMLElement>("[data-track]")];
  const overflow = (track: HTMLElement) =>
    track.offsetWidth - track.parentElement!.clientWidth;

  let progress = 0.5;

  const apply = () => {
    if (progress < 1) {
      window.scrollTo(0, 0);
      scroller.scrollTo(0, 0);
    }

    for (const track of tracks) {
      track.style.transform = `translateX(${-progress * overflow(track)}px)`;
    }
  };

  apply();

  window.addEventListener(
    "wheel",
    (event) => {
      const down = event.deltaY > 0;
      const horizontal =
        window.scrollY + scroller.scrollTop < 1 &&
        (down ? progress < 1 : progress > 0);
      if (!horizontal) return;

      event.preventDefault();
      const distance = Math.max(...tracks.map(overflow));
      progress = Math.min(1, Math.max(0, progress + event.deltaY / distance));
      apply();
    },
    { passive: false },
  );

  const pin = () => {
    if (progress < 1 && window.scrollY + scroller.scrollTop > 0) {
      window.scrollTo(0, 0);
      scroller.scrollTo(0, 0);
    }
  };
  window.addEventListener("scroll", pin);
  scroller.addEventListener("scroll", pin);

  window.addEventListener("resize", apply);
</script>
