---
import Layout from "./Layout.astro";
import type { Content, Thumbnail } from "../types";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/issues/**/*.{jpg,png,webp}",
  { eager: true },
);

type Props = {
  title: string;
  heading: string;
  contributors: string[];
  content: Content[];
  columns: [Thumbnail[], Thumbnail[], Thumbnail[], Thumbnail[], Thumbnail[]];
  cards: "outlined" | "filled";
};

const { title, heading, contributors, content, columns, cards } = Astro.props;

const ratio = (item: Thumbnail) =>
  "image" in item
    ? images[`../assets${item.image}`]!.default.height /
      images[`../assets${item.image}`]!.default.width
    : cards === "filled"
      ? 4 / 3
      : 9 / 8;

const mobileColumns: Thumbnail[][] = [[], [], []];
const heights = [0, 0, 0];
for (const item of columns.flat()) {
  const i = heights.indexOf(Math.min(...heights));
  mobileColumns[i]!.push(item);
  heights[i]! += ratio(item);
}
---

<Layout title={title}>
  <div
    slot="header"
    data-issue-header
    class="relative mt-10 flex flex-col gap-3 pb-2 max-md:hidden"
  >
    <div
      data-issue-shadow
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 shadow-xl"
    >
    </div>

    <h1
      class="text-primary text-center [font-feature-settings:'ss05'] text-[5.6rem] leading-none font-medium tracking-tighter"
    >
      {heading}
    </h1>

    <div class="flex items-center gap-2 px-36">
      <div class="flex-1 border-t border-black"></div>
      <a
        href="/shop"
        class="hover:bg-primary hover:border-primary rounded-lg border border-black bg-black px-2 py-1 text-3xl tracking-widest text-white italic"
        >subscribe</a
      >
      <div class="flex-1 border-t border-black"></div>
    </div>
  </div>

  <div class="flex flex-col items-center gap-9 px-8 pt-32 md:hidden">
    <h1
      class="text-center [font-feature-settings:'ss05'] text-5xl leading-none font-medium tracking-tighter"
    >
      {heading}
    </h1>

    <a
      href="/shop"
      class="hover:bg-primary hover:border-primary rounded-lg border border-black bg-black px-6 py-2 text-xl tracking-widest text-white italic"
      >subscribe</a
    >
  </div>

  <ul
    class="list-none columns-3 px-36 pt-24 text-center text-3xl leading-tight max-md:columns-2 max-md:px-3 max-md:pt-11 max-md:text-2xl"
  >
    {contributors.map((contributor) => <li>{contributor}</li>)}
  </ul>

  <div
    data-tracks="desktop"
    class="grid grid-cols-5 items-start gap-9 px-36 pt-36 max-md:hidden"
  >
    {
      columns.map((column) => (
        <div data-track class="flex flex-col gap-6">
          {column.map((item) => {
            const Tag = item.href ? "a" : "div";
            return (
              <Tag
                href={item.href}
                class="transition-opacity duration-200 hover:opacity-75"
              >
                {"image" in item ? (
                  <Image
                    src={images[`../assets${item.image}`]!.default}
                    alt=""
                    class="h-auto w-full"
                  />
                ) : (
                  <div
                    class:list={[
                      "border-primary font-times flex flex-col border-2",
                      cards === "filled"
                        ? "bg-primary text-secondary aspect-[3/4] pr-3 text-4xl leading-6 italic"
                        : "aspect-[8/9] justify-between bg-white p-3 text-xl leading-none",
                    ]}
                  >
                    <span class:list={{ uppercase: cards === "filled" }}>
                      {item.title}
                    </span>
                    <span
                      class:list={[
                        "self-end text-right",
                        { "my-auto": cards === "filled" },
                      ]}
                    >
                      {item.author}
                    </span>
                  </div>
                )}
              </Tag>
            );
          })}
        </div>
      ))
    }
  </div>

  <div
    data-tracks="mobile"
    class="grid grid-cols-3 items-start gap-8 px-8 pt-16 md:hidden"
  >
    {
      mobileColumns.map((column) => (
        <div data-track class="flex flex-col gap-6">
          {column.map((item) => {
            const Tag = item.href ? "a" : "div";
            return (
              <Tag href={item.href} class="hover:opacity-75 active:opacity-75">
                {"image" in item ? (
                  <Image
                    src={images[`../assets${item.image}`]!.default}
                    alt=""
                    class="h-auto w-full"
                  />
                ) : (
                  <div
                    class:list={[
                      "border-primary font-times flex flex-col border-2",
                      cards === "filled"
                        ? "bg-primary text-secondary aspect-[3/4] pr-3 text-lg leading-tight italic"
                        : "aspect-[8/9] justify-between bg-white p-3 text-sm leading-none",
                    ]}
                  >
                    <span class:list={{ uppercase: cards === "filled" }}>
                      {item.title}
                    </span>
                    <span
                      class:list={[
                        "self-end text-right",
                        { "my-auto": cards === "filled" },
                      ]}
                    >
                      {item.author}
                    </span>
                  </div>
                )}
              </Tag>
            );
          })}
        </div>
      ))
    }
  </div>

  <p
    class="font-times p-36 text-justify text-xl leading-tight max-md:px-8 max-md:py-16 max-md:text-2xl"
  >
    {
      content.map((entry, i) => {
        const Tag = entry.href ? "a" : "span";

        return (
          <>
            {i > 0 && " / "}{" "}
            <Tag href={entry.href} class={entry.href && "hover:text-primary"}>
              {entry.title.startsWith('"') ? entry.title : <i>{entry.title}</i>}
              , {entry.author}
            </Tag>
          </>
        );
      })
    }
  </p>
</Layout>

<script>
  const desktop = matchMedia(
    `(width >= ${getComputedStyle(document.documentElement).getPropertyValue("--breakpoint-md")})`,
  ).matches;

  {
    const scroller = document.querySelector<HTMLElement>("[data-scroller]")!;

    const block = document.querySelector<HTMLElement>("[data-issue-header]")!;
    const shadow = document.querySelector<HTMLElement>("[data-issue-shadow]")!;
    const grid = document.querySelector<HTMLElement>(
      `[data-tracks="${desktop ? "desktop" : "mobile"}"]`,
    )!;
    const tracks = [...grid.querySelectorAll<HTMLElement>("[data-track]")];

    const progress = (px: number) => {
      const l = Math.min(
        1,
        Math.max(0, (window.scrollY + scroller.scrollTop) / px),
      );
      return l < 0.5 ? 2 * l * l : 2 * l * (2 - l) - 1;
    };

    let margin = 0;
    const overlap = 12;

    const measure = () => {
      if (!desktop) return;
      block.style.marginTop = "";
      margin = parseFloat(getComputedStyle(block).marginTop);
    };

    const update = () => {
      if (desktop) {
        const p = progress(300);
        block.style.marginTop = `${margin * (1 - p) - overlap * p}px`;
        shadow.style.opacity = String(p);
      }

      const { top, height } = grid.getBoundingClientRect();
      const t = Math.min(
        1,
        Math.max(0, (window.innerHeight / 2 - top) / height),
      );
      const tallest = Math.max(...tracks.map((track) => track.offsetHeight));

      for (const track of tracks) {
        track.style.transform = `translateY(${t * (tallest - track.offsetHeight)}px)`;
      }
    };

    measure();
    update();

    window.addEventListener("scroll", update, { passive: true });

    scroller.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", () => {
      measure();
      update();
    });
  }
</script>
