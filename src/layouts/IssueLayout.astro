---
import Layout from "./Layout.astro";
import type { Content, Thumbnail } from "../types";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/issues/**/*.{jpg,png,webp}",
  { eager: true },
);

type Props = {
  title: string;
  heading: string;
  contributors: string[];
  content: Content[];
  columns: [Thumbnail[], Thumbnail[], Thumbnail[], Thumbnail[], Thumbnail[]];
};

const { title, heading, contributors, content, columns } = Astro.props;
---

<Layout title={title}>
  <div
    slot="header"
    data-issue-header
    class="relative mt-10 flex flex-col gap-3 pb-2"
  >
    <div
      data-issue-shadow
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 shadow-xl"
    >
    </div>

    <h1
      class="text-primary text-center [font-feature-settings:'ss05'] text-[5.6rem] leading-none font-medium tracking-tighter"
    >
      {heading}
    </h1>

    <div class="flex items-center gap-2 px-36">
      <div class="flex-1 border-t border-black"></div>
      <a
        href="/shop"
        class="hover:bg-primary hover:border-primary rounded-lg border border-black bg-black px-2 py-1 text-3xl tracking-widest text-white italic"
        >subscribe</a
      >
      <div class="flex-1 border-t border-black"></div>
    </div>
  </div>

  <ul
    class="list-none columns-3 px-36 pt-24 text-center text-3xl leading-tight"
  >
    {contributors.map((contributor) => <li>{contributor}</li>)}
  </ul>

  <div class="grid grid-cols-5 gap-9 px-36 pt-36">
    {
      columns.map((column) => (
        <div class="flex flex-col gap-6">
          {column.map((item) => {
            const Tag = item.href ? "a" : "div";
            return (
              <Tag href={item.href}>
                {"image" in item ? (
                  <Image
                    src={images[`../assets${item.image}`]!.default}
                    alt=""
                    class="h-auto w-full"
                  />
                ) : (
                  <div class="border-primary font-times flex aspect-[8/9] flex-col justify-between border-2 bg-white p-3 text-base">
                    <span>{item.title}</span>
                    <span class="self-end">{item.author}</span>
                  </div>
                )}
              </Tag>
            );
          })}
        </div>
      ))
    }
  </div>

  <p class="font-times p-36 text-justify text-xl leading-tight">
    {
      content.map((entry, i) => {
        const Tag = entry.href ? "a" : "span";

        return (
          <>
            {i > 0 && " / "}{" "}
            <Tag href={entry.href} class={entry.href && "hover:text-primary"}>
              {entry.title.startsWith('"') ? entry.title : <i>{entry.title}</i>}
              , {entry.author}
            </Tag>
          </>
        );
      })
    }
  </p>
</Layout>

<script>
  const block = document.querySelector<HTMLElement>("[data-issue-header]")!;
  const shadow = document.querySelector<HTMLElement>("[data-issue-shadow]")!;

  const progress = (px: number) => {
    const l = Math.min(1, Math.max(0, window.scrollY / px));
    return l < 0.5 ? 2 * l * l : 2 * l * (2 - l) - 1;
  };

  let margin = 0;
  const overlap = 12;

  const measure = () => {
    block.style.marginTop = "";
    margin = parseFloat(getComputedStyle(block).marginTop);
  };

  const update = () => {
    const p = progress(300);
    block.style.marginTop = `${margin * (1 - p) - overlap * p}px`;
    shadow.style.opacity = String(p);
  };

  measure();
  update();

  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", () => {
    measure();
    update();
  });
</script>
