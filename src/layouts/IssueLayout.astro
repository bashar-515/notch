---
import Layout from "./Layout.astro";

type Props = {
  title: string;
  heading: string;
};

const { title, heading } = Astro.props;
---

<Layout title={title}>
  <div class="flex flex-col pt-10">
    <header>
      <h1
        class="text-primary text-center [font-feature-settings:'ss05'] text-[5.6rem] leading-none font-medium tracking-tighter"
      >
        {heading}
      </h1>

      <div class="flex items-center gap-2 px-36">
        <div class="flex-1 border-t border-black"></div>
        <a href="/shop">subscribe</a>
        <div class="flex-1 border-t border-black"></div>
      </div>
    </header>
  </div>
</Layout>
