<script>
  const pill = document.querySelector<HTMLElement>("[data-substack]");

  if (pill) {
    const shift = pill.parentElement!;
    const group = shift.parentElement!;
    const hide = () => {
      pill.classList.add("translate-x-full");
      shift.classList.add("translate-x-6");
    };
    const timer = setTimeout(hide, 5000);

    requestAnimationFrame(() => {
      pill.classList.remove("translate-x-full");
      shift.classList.remove("translate-x-6");
    });
    group.addEventListener("mouseenter", () => clearTimeout(timer));
    group.addEventListener("mouseleave", hide);
  }

  const wrapper = document.querySelector<HTMLElement>("[data-pill]");
  const footer = document.querySelector("footer");

  if (wrapper && footer) {
    new IntersectionObserver(([entry]) => {
      for (const c of ["translate-x-full", "-mr-6", "pointer-events-none"])
        wrapper.classList.toggle(c, entry!.isIntersecting);
    }).observe(footer);
  }
</script>

<script>
  const scroller = document.querySelector<HTMLElement>("[data-scroller]")!;

  const header = document.querySelector<HTMLElement>("header");
  const nav = document.querySelector<HTMLElement>("nav");

  if (header?.dataset.home === "true") {
    const update = () => {
      const progress = Math.min(
        1,
        Math.max(
          0,
          (window.scrollY + scroller.scrollTop - 0.5 * window.innerHeight) /
            (0.25 * window.innerHeight),
        ),
      );

      header.style.opacity = String(progress);
      header.style.pointerEvents = progress < 0.05 ? "none" : "auto";
    };

    update();

    window.addEventListener("scroll", update, { passive: true });

    scroller.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
  } else if (nav) {
    const progress = (px: number) => {
      const l = Math.min(
        1,
        Math.max(0, (window.scrollY + scroller.scrollTop) / px),
      );
      return l < 0.5 ? 2 * l * l : 2 * l * (2 - l) - 1;
    };

    const update = () => {
      const fade = 1 - progress(50);

      for (const link of nav.querySelectorAll("a")) {
        if (link.getAttribute("href") === "/") {
          link.style.transform = `scale(${1 - 0.2 * progress(300)})`;
        } else {
          link.style.opacity = String(fade);
          link.style.visibility = fade ? "visible" : "hidden";
        }
      }

      if (header && "fade" in header.dataset) {
        const visible = 1 - progress(50);
        header.style.opacity = String(visible);
        header.style.pointerEvents = visible ? "auto" : "none";
      }
    };

    update();

    window.addEventListener("scroll", update, { passive: true });

    scroller.addEventListener("scroll", update, { passive: true });
  }
</script>

<script>
  const scroller = document.querySelector<HTMLElement>("[data-scroller]")!;

  const logo = document.querySelector<HTMLElement>("[data-footer-logo]");

  if (logo) {
    const update = () => {
      const { top, height } = logo.getBoundingClientRect();
      logo.style.opacity = String(
        Math.min(1, Math.max(0, (window.innerHeight - top) / height)),
      );
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    scroller.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
  }
</script>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>(
    "form[name^=subscribe]",
  )) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector("button")!;
      button.disabled = true;
      button.classList.add("animate-pulse");

      const response = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams([...new FormData(form)] as string[][]),
      });

      button.classList.remove("animate-pulse");
      if (response.ok) button.textContent = "Thank you";
      else button.disabled = false;
    });
  }
</script>

<script>
  const scroller = document.querySelector<HTMLElement>("[data-scroller]")!;

  const title = document.querySelector<HTMLElement>("[data-title]")!;
  const overlay = title.querySelector<HTMLElement>("span")!;
  const sections = document.querySelectorAll("[data-dark]");

  const update = () => {
    const t = title.getBoundingClientRect();
    let top = 100;
    let bottom = 0;

    for (const section of sections) {
      const r = section.getBoundingClientRect();
      if (r.bottom > t.top && r.top < t.bottom) {
        top = (Math.max(0, r.top - t.top) / t.height) * 100;
        bottom = (Math.max(0, t.bottom - r.bottom) / t.height) * 100;
      }
    }

    overlay.style.clipPath = `inset(${top}% 0 ${bottom}% 0)`;
  };

  update();
  window.addEventListener("scroll", update, { passive: true });
  scroller.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update, { passive: true });
</script>

<script>
  const scroller = document.querySelector<HTMLElement>("[data-scroller]")!;

  const box = document.querySelector<HTMLElement>("[data-pill]");
  const footer = document.querySelector("footer");

  if (box && footer) {
    const update = () => {
      const clear =
        footer.getBoundingClientRect().top >=
        box.getBoundingClientRect().bottom;
      if (clear) box.classList.add("group");
      else if (!box.matches(":hover")) box.classList.remove("group");
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    scroller.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
    box.addEventListener("mouseleave", () => requestAnimationFrame(update));
  }
</script>

<style>
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .marquee {
    animation: marquee 60s linear infinite;
  }
</style>
