---
import Instagram from "../components/icons/Instagram.astro";
import Logo from "../components/icons/Logo.astro";
import X from "../components/icons/X.astro";
import "../styles/global.css";

type Link = { href: string; label: string };

type Props = {
  title?: string;
  overlayHeader?: boolean;
  fadeHeader?: boolean;
  banner?: boolean;
};

const {
  title,
  overlayHeader = Astro.url.pathname === "/",
  fadeHeader = false,
  banner = Astro.url.pathname !== "/",
} = Astro.props;

const home = Astro.url.pathname === "/";

const navLinks: Link[] = [
  { href: "/issues", label: "ISSUES" },
  { href: "/events", label: "EVENTS" },
  { href: "/", label: "NOTCH MAGAZINE" },
  { href: "/stockists", label: "STOCKISTS" },
  { href: "/shop", label: "SHOP" },
];

const footerLinksByColumn: Link[][] = [
  [
    { href: "/about", label: "About" },
    { href: "/events", label: "Events" },
  ],
  [
    { href: "/issues", label: "Issues" },
    { href: "/stockists", label: "Stockists" },
  ],
  [
    { href: "/donate", label: "Support" },
    { href: "/shop", label: "Subscribe" },
  ],
  [
    { href: "/shop", label: "Shop" },
    { href: "/submissions", label: "Submit" },
  ],
];
---

<html lang="en" class="bg-primary max-md:overflow-x-hidden max-md:bg-white">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" />

    <link
      rel="preload"
      href="/fonts/Gravity/Gravity/ABCGravity-Compressed.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title ? `Notch Magazine — ${title}` : "Notch Magazine"}</title>
  </head>

  <body
    class:list={[
      "max-md:h-dvh max-md:overflow-hidden max-md:bg-white",
      Astro.url.pathname !== "/" && "bg-secondary",
    ]}
  >
    <div
      class="border-primary pointer-events-none fixed inset-0 z-10 border-[0.5rem] max-md:hidden"
    >
    </div>

    <div
      data-scroller
      class="max-md:bg-primary max-md:isolate max-md:h-dvh max-md:overflow-x-hidden max-md:overflow-y-auto max-md:overscroll-y-contain"
    >
      <div
        class:list={["flex min-h-dvh flex-col", !home && "max-md:bg-secondary"]}
      >
        <header
          data-home={Astro.url.pathname === "/" || undefined}
          data-fade={fadeHeader || undefined}
          class:list={[
            "group inset-x-0 data-[home=true]:opacity-0",
            overlayHeader ? "fixed" : "sticky",
            banner ? "top-0 z-20" : "top-2 z-1",
          ]}
        >
          {
            banner && (
              <a
                href="https://notchmagazine.substack.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-primary text-secondary block overflow-hidden py-2 text-xl font-medium whitespace-nowrap select-none max-md:hidden"
              >
                <div class="marquee flex w-max">
                  {[0, 1].map((half) => (
                    <div class="flex" aria-hidden={half === 1}>
                      {Array.from({ length: 10 }).map(() => (
                        <span class="flex items-center gap-1 px-12">
                          <img
                            src="/substack.png"
                            alt=""
                            class="h-[1.5em] w-auto"
                          />
                          NOTCH IS NOW ON SUBSTACK
                        </span>
                      ))}
                    </div>
                  ))}
                </div>
              </a>
            )
          }

          <div class:list={[Astro.slots.has("header") && "bg-secondary mx-2"]}>
            <nav
              class="text-primary group-data-[home=true]:bg-secondary flex items-center justify-between px-27 py-3"
            >
              {
                navLinks.map((link) => (
                  <a
                    href={link.href}
                    data-title={link.href === "/" || undefined}
                    class={
                      link.href === "/"
                        ? "relative font-sans text-6xl"
                        : `font-sans text-3xl ${Astro.url.pathname === link.href ? "" : "decoration-1 underline-offset-4 hover:underline"}`
                    }
                  >
                    {link.label}
                    {link.href === "/" && (
                      <span
                        class="text-secondary absolute inset-0"
                        aria-hidden="true"
                      >
                        {link.label}
                      </span>
                    )}
                  </a>
                ))
              }
            </nav>

            <slot name="header" />
          </div>
        </header>

        <main class="flex flex-1 flex-col">
          <slot />
        </main>
      </div>

      <footer
        class="bg-tertiary font-times max-md:bg-secondary grid grid-cols-3 items-center px-24 py-6 max-md:grid-cols-1 max-md:px-6 max-md:py-0"
      >
        <div class="flex max-md:hidden">
          <a href="/" data-footer-logo
            ><Logo
              class="hover:text-secondary h-32 w-auto text-white transition-colors duration-200"
            /></a
          >

          <div class="ml-auto flex gap-4 self-center">
            {
              footerLinksByColumn.map((column) => (
                <div class="flex flex-col gap-2">
                  {column.map((link) => (
                    <a
                      href={link.href}
                      class="text-primary hover:text-secondary text-lg font-bold"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              ))
            }
          </div>
        </div>

        <div class="text-center">
          <div class="m-8 flex justify-center gap-6 max-md:hidden">
            <a
              href="https://www.instagram.com/notch.magazine/"
              rel="noopener noreferrer"
              class="hover:text-secondary font-bold text-white transition-colors duration-200"
              ><Instagram class="h-7 w-auto" /></a
            >
            <a
              href="https://x.com/notch_magazine"
              rel="noopener noreferrer"
              class="hover:text-secondary text-white transition-colors duration-200"
              ><X class="h-7 w-auto" /></a
            >
          </div>

          <p
            class="text-lg max-md:mx-auto max-md:w-fit max-md:py-3 max-md:text-xl max-md:italic max-md:before:mx-auto max-md:before:mb-3 max-md:before:block max-md:before:w-1/2 max-md:before:border-t max-md:before:border-black"
          >
            © <span class="italic">2026, Notch Magazine, LLC</span>
          </p>
        </div>

        <form
          name="subscribe-footer"
          method="POST"
          data-netlify="true"
          class="flex flex-col gap-1 justify-self-end max-md:hidden"
        >
          <input type="hidden" name="form-name" value="subscribe-footer" />
          <p class="px-2 text-lg italic">Sign up to receive news and updates</p>

          <input
            type="email"
            name="email"
            placeholder="Email"
            class="border-secondary rounded-sm border px-6 py-1 focus:outline-none"
          />
          <button
            type="submit"
            class="hover:bg-secondary text-primary cursor-pointer rounded-sm bg-white py-1 transition-colors duration-200"
            >Sign up</button
          >
        </form>
      </footer>
    </div>

    {
      !banner && (
        <div
          data-pill
          class="group fixed right-6 bottom-6 z-30 rounded-l-full transition-all duration-500 after:absolute after:inset-y-0 after:-right-6 after:w-6 max-md:hidden"
        >
          <div
            class:list={[
              "rounded-l-full",
              home &&
                "translate-x-6 transition-transform duration-500 group-hover:translate-x-0",
            ]}
          >
            <a
              data-substack={home || undefined}
              href="https://notchmagazine.substack.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-primary text-secondary relative flex translate-x-full items-center gap-1 rounded-full px-6 py-2 text-xl font-medium whitespace-nowrap transition-transform duration-500 select-none group-hover:translate-x-0"
            >
              <img src="/substack.png" alt="" class="h-[1.5em] w-auto" />
              NOTCH IS NOW ON SUBSTACK
            </a>
          </div>
        </div>
      )
    }
  </body>
</html>

