---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"articles">["data"];

const { title, author, issue, bio } = Astro.props;
---

<Layout title={title}>
  <article class="pt-frame w-3/4 px-36">
    <h1
      class="[font-feature-settings:'ss05'] text-7xl leading-none font-medium tracking-tighter whitespace-pre-line"
    >
      {title}
    </h1>

    <div class="text-primary flex border-t border-b">
      <p>{author}</p>
      <p>Issue {issue}</p>
    </div>

    <slot />

    {bio && <p set:html={bio} />}
  </article>
</Layout>
