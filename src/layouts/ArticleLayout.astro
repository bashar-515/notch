---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"articles">["data"];
const { title, author, issue, bio, related, previous, next } = Astro.props;

const issueNames = { "001": "Potential Energy", "002": "Gravity" };

const articles = await getCollection("articles");
const relatedArticles = related.flatMap((id) =>
  articles.filter((article) => article.id === id),
);
---

<Layout title={author.toLowerCase()} overlayHeader fadeHeader>
  <div class="flex gap-44 px-36 pb-42">
    <article class="w-7/10 pt-36">
      <h1
        class="[font-feature-settings:'ss05'] text-7xl leading-none font-medium tracking-tighter whitespace-pre-line"
      >
        {title}
      </h1>

      <div
        class="text-primary mt-3 flex justify-between border-y border-black py-1 text-3xl italic"
      >
        <p>{author}</p>
        <a href={`/issue${issue}/`} class="hover:text-black"
          >Issue {issue}: {issueNames[issue]}</a
        >
      </div>

      <div
        class="font-times [&_hr]:border-primary mt-8 space-y-6 text-2xl leading-tight [&_hr]:my-12"
      >
        <slot />
      </div>

      {
        bio.length > 0 && (
          <div class="font-times text-primary mt-24 space-y-4 text-xl leading-tight italic">
            {bio.map((paragraph) => (
              <p set:html={paragraph} />
            ))}
          </div>
        )
      }
    </article>

    <div
      class="sticky top-0 flex h-dvh flex-1 flex-col items-end justify-center-safe self-start pt-36"
    >
      <a
        href="/shop"
        class="hover:bg-primary hover:border-primary rounded-lg border border-black bg-black px-2 py-1 text-2xl tracking-widest text-white italic"
        >subscribe</a
      >

      <ul
        class="text-primary mt-6 w-full list-none divide-y-3 divide-black border-t-3 border-b-3 border-black text-right text-2xl"
      >
        {
          relatedArticles.map((article) => (
            <li class="py-2">
              <a href={`/${article.id}/`} class="flex flex-col gap-3">
                <p class="italic">{article.data.title}</p>
                <p>by {article.data.author}</p>
              </a>
            </li>
          ))
        }
      </ul>

      <nav
        class="font-times mt-6 flex w-full flex-col gap-2 text-xl leading-none"
      >
        {
          next && (
            <a href={`/${next}/`} class="self-end hover:underline">
              next piece →
            </a>
          )
        }
        {
          previous && (
            <a href={`/${previous}/`} class="self-start hover:underline">
              ← previous piece
            </a>
          )
        }
      </nav>
    </div>
  </div>
</Layout>
