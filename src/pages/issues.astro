---
import Layout from "../layouts/Layout.astro";

const issues: {
  front: string;
  back: string;
  href?: string;
  preorder?: boolean;
}[] = [
  { front: "/001_front.webp", back: "/001_back.webp", href: "/issue001/" },
  { front: "/002_front.webp", back: "/002_back.webp", href: "/issue002/" },
  {
    front: "/003_front.jpg",
    back: "/003_back.jpg",
    href: "https://notchmagazine.substack.com/",
  },
  { front: "/004_front.webp", back: "/004_back.webp", preorder: true },
];
---

<Layout title="issues">
  <div
    class="p-frame max-md:divide-primary my-auto grid grid-cols-4 gap-x-10 gap-y-20 max-md:flex max-md:flex-col-reverse max-md:gap-y-0 max-md:divide-y max-md:divide-y-reverse max-md:px-11 max-md:pt-30 max-md:pb-10"
  >
    {
      issues.map((issue) => (
        <div class="flex flex-col gap-10 max-md:py-14">
          <div class="group relative flex-1 shadow-2xl">
            <img src={issue.front} class="h-full w-full object-cover" />

            <img
              src={issue.back}
              class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100 group-active:opacity-100"
            />
          </div>

          <div class="flex">
            <a
              href="/shop/"
              class="font-times hover:bg-primary hover:border-primary mr-auto rounded-sm border border-black bg-black px-4 py-1 text-2xl tracking-widest text-white italic"
            >
              {issue.preorder ? "preorder" : "order"}
            </a>

            {issue.href && (
              <a
                href={issue.href}
                class="hover:bg-primary hover:border-primary font-times rounded-sm border border-black px-4 py-1 text-2xl tracking-widest italic hover:text-white"
              >
                explore
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</Layout>
