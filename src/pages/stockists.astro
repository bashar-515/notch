  | "NEW YORK"
  | "GLASGOW"
  | "LONDON"
  | "PARIS"
  | "BERLIN"
  | "STOCKHOLM"
  | "ATHENS";

type Stockist = {
  name: string;
  address: string;
  place: string;
  dotLabel: DotLabel;
  heading?: string;
};

const boxAnchor = {
  top: "md:top-full md:left-1/2 md:mt-2 md:-translate-x-1/2",
  bottom: "md:bottom-full md:left-1/2 md:mb-2 md:-translate-x-1/2",
  left: "md:top-1/2 md:left-full md:ml-2 md:-translate-y-1/2",
  right: "md:top-1/2 md:right-full md:mr-2 md:-translate-y-1/2",
  "top-left": "md:top-full md:left-full md:mt-1 md:ml-1",
  "top-right": "md:top-full md:right-full md:mt-1 md:mr-1",
  "bottom-left": "md:bottom-full md:left-full md:mb-1 md:ml-1",
  "bottom-right": "md:right-full md:bottom-full md:mr-1 md:mb-1",
};

type BoxAnchor = keyof typeof boxAnchor;

const mobileBoxAnchor: Record<BoxAnchor, string> = {
  top: "max-md:top-full max-md:left-1/2 max-md:mt-2 max-md:-translate-x-1/2",
  bottom:
    "max-md:bottom-full max-md:left-1/2 max-md:mb-2 max-md:-translate-x-1/2",
  left: "max-md:top-1/2 max-md:left-full max-md:ml-2 max-md:-translate-y-1/2",
  right: "max-md:top-1/2 max-md:right-full max-md:mr-2 max-md:-translate-y-1/2",
  "top-left": "max-md:top-full max-md:left-full max-md:mt-1 max-md:ml-1",
  "top-right": "max-md:top-full max-md:right-full max-md:mt-1 max-md:mr-1",
  "bottom-left": "max-md:bottom-full max-md:left-full max-md:mb-1 max-md:ml-1",
  "bottom-right":
    "max-md:right-full max-md:bottom-full max-md:mr-1 max-md:mb-1",
