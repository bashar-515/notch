---

<Layout title="stockists">
  <div class="py-frame grid grid-cols-2">
    <div class="col-span-full row-start-1 grid w-[82%] self-start">
      <Image
        src={map}
        alt="Map of Notch stockists"
        widths={[960, 1440, 1920, 2880]}
        sizes="82vw"
        loading="eager"
        fetchpriority="high"
        class="col-start-1 row-start-1 h-auto w-full text-transparent"
      />

      {
        dots.map((dot) => (
          <div
            class="group bg-primary relative col-start-1 row-start-1 size-4 -translate-x-1/2 -translate-y-1/2 cursor-pointer self-start justify-self-start rounded-full hover:order-last"
            style={`left: ${dot.x}%; top: ${dot.y}%`}
          >
            <div
              class:list={[
                "text-primary invisible absolute w-max rounded-sm bg-white px-1 pt-0.5 leading-[1.74rem] whitespace-nowrap opacity-0 shadow-[0_1px_3px_rgba(0,0,0,.18),0_-1px_0_rgba(0,0,0,.03)] group-hover:visible group-hover:opacity-100 group-hover:transition-opacity group-hover:duration-100",
                boxAnchor[dot.anchor],
              ]}
            >
              {Object.entries(
                Object.groupBy(
                  stockists.filter((s) => s.dotLabel === dot.label),
                  (s) => s.heading ?? dot.label,
                ),
              ).map(([heading, group], index) => (
                <>
                  {index > 0 && <br />}
                  <p class="font-times text-[1.65rem] font-bold">{heading}</p>
                  {[...new Set(group!.map((s) => s.name))].map((name) => (
                    <p class="font-georgia text-[1.28rem] italic">{name}</p>
                  ))}
                </>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div
      class="col-start-2 row-start-1 mx-24 flex flex-col items-center self-start border-b-2 border-black"
    >
      {
        Object.entries(stockistsByLocation).map(([location, columns]) => (
          <details name="stockist" class="drawer w-full">
            <summary class="font-times relative flex cursor-pointer list-none items-center justify-center border-t-2 border-black py-4 text-3xl [&::-webkit-details-marker]:hidden">
              {location}
              <span class="absolute right-4 transition-transform duration-200 [[open]>summary>&]:rotate-90">
                ❯
              </span>
            </summary>
            <div class="min-h-0">
              <div class="flex gap-12 pb-6">
                {columns.map((column) => (
                  <div class="flex flex-1 flex-col gap-6">
                    {column.map((stockist) => (
                      <div class="font-times ml-8 text-[1.375rem] leading-none">
                        <p class="font-bold">{stockist.name}</p>
                        <p>{stockist.address},</p>
                        <p>{stockist.place}</p>
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .drawer::details-content {
    display: grid;
    grid-template-rows: 0fr;
    overflow: clip;
    transition:
      grid-template-rows 200ms ease-out,
      content-visibility 200ms allow-discrete;
  }

  .drawer[open]::details-content {
    grid-template-rows: 1fr;
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer::details-content {
      transition: none;
    }
  }
</style>
