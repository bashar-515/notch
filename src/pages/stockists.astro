const boxAnchor = {
  top: "top-full left-1/2 mt-2 -translate-x-1/2",
  bottom: "bottom-full left-1/2 mb-2 -translate-x-1/2",
  left: "top-1/2 left-full ml-2 -translate-y-1/2",
  right: "top-1/2 right-full mr-2 -translate-y-1/2",
  "top-left": "top-full left-full mt-1 ml-1",
  "top-right": "top-full right-full mt-1 mr-1",
  "bottom-left": "bottom-full left-full mb-1 ml-1",
  "bottom-right": "right-full bottom-full mr-1 mb-1",
};

type BoxAnchor = keyof typeof boxAnchor;

type Dot = {
  label: DotLabel;
  anchor: BoxAnchor;
  x: number;
