---

<Layout title="shop">
  <div
    class="p-frame flex flex-col gap-26 max-md:gap-16 max-md:px-8 max-md:pt-40 max-md:pb-16"
  >
    {products.map((product, idx) => <Product product={product} idx={idx} />)}
  </div>
</Layout>

<script>
  const center = () => {
    const target =
      location.hash &&
      document.querySelector(`[data-id="${location.hash.slice(1)}"]`);
    if (target) {
      target.scrollIntoView({ block: "center", behavior: "smooth" });
    }
  };

  if (document.querySelector('meta[name="astro-view-transitions-enabled"]'))
    document.addEventListener("astro:page-load", center);
  else center();
</script>
