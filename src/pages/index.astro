---
import Layout from "../layouts/Layout.astro";
import Logos from "../components/Logos.astro";
---

<Layout>
  <Logos />

  <div class="flex flex-col gap-28 max-md:gap-0">
    <div
      class="bg-secondary grid h-[125vh] content-center px-72 pb-[25vh] max-md:h-lvh max-md:content-start max-md:px-14 max-md:pb-0"
    >
      <div class="grid h-svh content-center md:contents">
        <p
          class="text-primary font-sans text-[16rem] leading-none max-md:text-[12rem]"
        >
          NOTCH
        </p>
        <p
          class="font-times -mt-9 text-4xl italic max-md:-mt-6 max-md:w-3/4 max-md:text-3xl max-md:leading-tight"
        >
          Interweaving artistic genres, inviting unfamiliar encounters
        </p>
        <p
          class="text-primary font-times text-right text-2xl max-md:mt-2 max-md:w-5/12 max-md:justify-self-end max-md:leading-tight"
        >
          a literary and arts magazine
        </p>
      </div>
    </div>

    <div data-dark class="h-28 md:hidden"></div>

    <div
      class="bg-secondary text-statement flex h-[75vh] flex-col items-center justify-center gap-14 px-120 text-center max-md:h-svh max-md:justify-start max-md:px-6 max-md:text-2xl"
    >
      <div
        class="mt-20 flex h-svh flex-col items-center justify-center gap-14 md:contents"
      >
        <p>
          <span class="block" data-reveal
            >Notch is a literary and arts magazine</span
          >
          <span class="block" data-reveal>based in New York and Paris. We</span>
          <span class="block" data-reveal
            >publish biannually in print and online.</span
          >
          <span class="block" data-reveal
            >Subscribe <a
              href="/shop"
              class="hover:text-primary underline decoration-1 underline-offset-8"
              >here</a
            >.
          </span>
        </p>

        <p>
          <span class="block" data-reveal
            >Submissions are currently closed.</span
          >
        </p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const scroller = document.querySelector<HTMLElement>("[data-scroller]")!;

  const lines = document.querySelectorAll<HTMLElement>("[data-reveal]");

  const update = () => {
    const revealY = 0.75 * window.innerHeight;
    const band = 0.15 * window.innerHeight;

    for (const line of lines) {
      const { top } = line.getBoundingClientRect();
      line.style.opacity = String(
        Math.min(1, Math.max(0, (revealY - top) / band)),
      );
    }
  };

  update();
  window.addEventListener("scroll", update, { passive: true });
  scroller.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update, { passive: true });
</script>
