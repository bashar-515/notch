---
import EventPage from "../components/EventPage.astro";
import image from "../assets/shop/004release/nyc/2.jpg";
---

<EventPage
  image={image}
  date="October 15"
  venue={{ name: "Telo Haus", href: "https://telos.haus/" }}
  address={{
    label: "303 Ten Eyck St, Brooklyn, NY",
    href: "https://www.google.com/maps/search/?api=1&query=303+Ten+Eyck+St+Brooklyn+NY",
  }}
  schedule={[
    { time: "7", description: "Invite-only cocktail hour" },
    {
      time: "8",
      description:
        'All guests welcome (general tickets can be reserved <a href="/shop#nycissue004release">here</a>)',
    },
    { time: "9", description: "Reading and artist talks" },
    { time: "10", description: "Music" },
  ]}
  paragraphs={[
    "Please join us for a cocktail hour ahead of the release party. The evening will include a chance to meet some of the artists and writers featured in the issue.",
    "You are welcome to bring one guest, but we ask that you reserve tickets accordingly. Tickets include entry to the general party which starts at 8pm.",
    '<a href="/donate">Donors</a> are welcome for free.',
  ]}
  price="$60"
  buttonText="buy tickets"
  stripeUrl="https://buy.stripe.com/bJe6oHfDUddWdcN9lO9ws0b"
>
  <i class="mr-[0.1em]">Notch Magazine</i>{" "}cordially invites you to
  celebrate the release of ISSUE 004: IF/ELSE.
</EventPage>
