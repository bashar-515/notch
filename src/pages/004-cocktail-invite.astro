---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/shop/004release/*.jpg",
  { eager: true },
);

const image = images["../assets/shop/004release/2.jpg"]!.default;
---

<BaseLayout htmlClass="h-dvh overflow-hidden" bodyClass="h-dvh overflow-hidden">
  <div class="bg-tertiary h-dvh overflow-y-auto overscroll-y-contain p-10">
    <Image src={image} alt="" class="mx-auto max-h-full w-auto max-w-full" />
  </div>
</BaseLayout>
