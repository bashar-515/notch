---
import Layout from "../layouts/Layout.astro";

type Person = {
  name: string;
  role: string;
};

const people: Person[] = [
  { name: "SASHA LANDAUER", role: "Editor, Writing" },
  { name: "ANGELA BLACK", role: "Editor, Art & Essays\nArt Director" },
  { name: "ARINA ZHURAVLEVA", role: "Designer" },
  { name: "MADELINE HAZE CURTIS", role: "Copyeditor" },
  { name: "KATERINA PAVLIDIS", role: "Reader, Poetry" },
  { name: "MARY BERG", role: "Curatorial Consultant" },
  { name: "ANDI GRENE", role: "Editorial Assistant, Writing" },
  { name: "NEDA RAD", role: "Creative Strategist & Marketing" },
  { name: "TEDDY OGBORN", role: "Social Media Lead" },
  { name: "TAMSYN CHANDLER", role: "Stockists Manager & Events" },
  { name: "CROFT & JOHNSON LLP", role: "Legal Counsel" },
  { name: "BASHAR EID", role: "Web Developer" },
];
---

<Layout title="about" overlayHeader>
  <div
    class="text-statement flex h-[110vh] flex-col items-center justify-center gap-14 px-85 text-center"
  >
    <p>
      Notch is a literary and arts magazine based in New York and Paris,
      published biannually in print and online.
    </p>

    <p>
      Notch was founded with the goal of de-siloing the creative arts and
      underscoring their shared root system. We consider all genres with an
      equal level of seriousness—publishing nail art alongside 18th century
      philosophy; scientific essays with video sculpture. Each issue has a
      unique theme which forms a critical connective tissue between selected
      works. By presenting these strange combinations, we honor otherness.
    </p>

    <p>Submissions are currently closed.</p>
  </div>

  <div
    data-dark
    class="bg-primary font-times flex flex-col gap-14 px-32 py-28 text-2xl leading-none text-white"
  >
    <h2 class="group font-sans text-7xl tracking-widest" data-masthead>
      {
        "MASTHEAD".split("").map((letter, i) => (
          <span
            class="opacity-0 transition-none duration-300 ease-in-out group-data-inview:opacity-100 group-data-inview:transition-opacity motion-reduce:group-data-inview:transition-none"
            style={`transition-delay: ${i * 100}ms`}
          >
            {letter}
          </span>
        ))
      }
    </h2>

    <div
      class="grid grid-cols-[auto_auto_auto] justify-between gap-x-14 gap-y-14"
    >
      {
        people.map((person) => (
          <div>
            <p>{person.name}</p>
            <p class="whitespace-pre-line">{person.role}</p>
          </div>
        ))
      }
    </div>

    <p class="italic">For inquiries: editors@notch.ink.</p>
  </div>
</Layout>

<script>
  const heading = document.querySelector<HTMLElement>("[data-masthead]");

  if (heading) {
    new IntersectionObserver(([entry]) => {
      if (entry!.isIntersecting) heading.dataset.inview = "";
      else delete heading.dataset.inview;
    }).observe(heading);
  }
</script>
