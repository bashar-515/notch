---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import Logos from "../components/Logos.astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/events/**/*.{jpg,png}",
  { eager: true },
);

type Event = {
  name: string;
  coverImage: string;
  collageImagesByColumn: string[][];
  href?: string;
};

const events: Event[] = [
  {
    name: "issue 003: currents launch, london",
    coverImage: "/events/003/cover.jpg",
    collageImagesByColumn: [
      ["/events/003/col-1/1.jpg", "/events/003/col-1/2.jpg"],
      ["/events/003/col-2/1.jpg"],
      ["/events/003/col-3/1.jpg"],
    ],
    href: "/issue003release/",
  },
  {
    name: "issue 002: gravity launch, nyc",
    coverImage: "/events/002/cover.jpg",
    collageImagesByColumn: [
      ["/events/002/col-1/1.jpg", "/events/002/col-1/2.jpg"],
      ["/events/002/col-2/1.jpg", "/events/002/col-2/2.jpg"],
      ["/events/002/col-3/1.jpg", "/events/002/col-3/2.jpg"],
      ["/events/002/col-4/1.jpg", "/events/002/col-4/2.jpg"],
      ["/events/002/col-5/1.jpg", "/events/002/col-5/2.jpg"],
    ],
    href: "/issue002release/",
  },
  {
    name: "notch x color of sound, atelier, paris",
    coverImage: "/events/atelier/cover.jpg",
    collageImagesByColumn: [
      [
        "/events/atelier/col-1/1.jpg",
        "/events/atelier/col-1/2.jpg",
        "/events/atelier/col-1/3.jpg",
      ],
      [
        "/events/atelier/col-2/1.jpg",
        "/events/atelier/col-2/2.jpg",
        "/events/atelier/col-2/3.jpg",
      ],
      [
        "/events/atelier/col-3/1.jpg",
        "/events/atelier/col-3/2.png",
        "/events/atelier/col-3/3.jpg",
      ],
      [
        "/events/atelier/col-4/1.jpg",
        "/events/atelier/col-4/2.jpg",
        "/events/atelier/col-4/3.jpg",
      ],
    ],
    href: "/gravityatelier",
  },
  {
    name: "notch magazine launch, nyc",
    coverImage: "/events/launch/cover.jpg",
    collageImagesByColumn: [
      [
        "/events/launch/col-1/1.jpg",
        "/events/launch/col-1/2.jpg",
        "/events/launch/col-1/3.jpg",
      ],
      [
        "/events/launch/col-2/1.jpg",
        "/events/launch/col-2/2.jpg",
        "/events/launch/col-2/3.jpg",
      ],
      [
        "/events/launch/col-3/1.jpg",
        "/events/launch/col-3/2.jpg",
        "/events/launch/col-3/3.jpg",
      ],
      [
        "/events/launch/col-4/1.jpg",
        "/events/launch/col-4/2.jpg",
        "/events/launch/col-4/3.jpg",
      ],
    ],
    href: "/issue001launch",
  },
];

const posters: {
  image: string;
  width: number;
  height: number;
  zoom?: boolean;
  href?: string;
}[] = [
  { image: "/events/1.png", width: 512, height: 689 },
  { image: "/events/2.jpg", width: 533, height: 689 },
  { image: "/events/3.png", width: 528, height: 695 },
  { image: "/events/4.jpg", width: 561, height: 702, zoom: true },
  { image: "/events/5.jpg", width: 507, height: 720, href: "/issue001launch" },
  { image: "/events/6.png", width: 510, height: 717 },
  { image: "/events/7.jpg", width: 705, height: 720 },
  { image: "/events/8.jpg", width: 510, height: 717, href: "/gravityatelier" },
];
---

<Layout title="events">
  <div class="bg-primary isolate flex flex-col">
    <Logos />

    <div class="bg-secondary px-frame divide-primary min-h-dvh divide-y pb-10">
      {
        events.map((event) => (
          <div class="group/event flex py-18 first:-mt-4 even:flex-row-reverse">
            {event.href ? (
              <a
                href={event.href}
                class="w-96 shrink-0 transition-opacity duration-200 hover:opacity-75"
              >
                <Image
                  src={images[`../assets${event.coverImage}`].default}
                  alt={event.name}
                  width={800}
                  class="aspect-[7/10] w-full object-cover"
                />
              </a>
            ) : (
              <Image
                src={images[`../assets${event.coverImage}`].default}
                alt={event.name}
                width={800}
                class="aspect-[7/10] w-96 object-cover"
              />
            )}

            {event.href ? (
              <div class="rotate-0 self-center py-7 text-3xl leading-none italic [writing-mode:vertical-rl] group-even/event:rotate-180">
                <a href={event.href} class="hover:text-primary">
                  {event.name}
                </a>
              </div>
            ) : (
              <div class="rotate-0 self-center py-7 text-3xl leading-none italic [writing-mode:vertical-rl] group-even/event:rotate-180">
                {event.name}
              </div>
            )}

            <div class="flex flex-1">
              {event.collageImagesByColumn.map((column) => (
                <div class="flex min-w-0 flex-1 flex-col">
                  {column.map((image) =>
                    event.href ? (
                      <a
                        href={event.href}
                        class="min-h-0 w-full flex-1 transition-opacity duration-200 hover:opacity-75"
                      >
                        <Image
                          src={images[`../assets${image}`].default}
                          alt={event.name}
                          width={500}
                          class="h-full w-full object-cover"
                        />
                      </a>
                    ) : (
                      <Image
                        src={images[`../assets${image}`].default}
                        alt={event.name}
                        width={500}
                        class="min-h-0 w-full flex-1 object-cover"
                      />
                    ),
                  )}
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <div data-dark class="h-28"></div>
    <div class="bg-secondary px-frame min-h-dvh pb-36">
      <div class="flex flex-wrap justify-center gap-x-11 gap-y-7 pt-24">
        {
          posters.map((poster, i) =>
            poster.href ? (
              <a
                href={poster.href}
                class="overflow-hidden shadow-xl transition-opacity duration-200 hover:opacity-75"
              >
                <Image
                  src={images[`../assets${poster.image}`].default}
                  alt="Notch event poster"
                  width={poster.width}
                  height={poster.height}
                  class:list={[
                    "w-auto",
                    i < 4 ? "h-88" : "h-92",
                    poster.zoom && "scale-150",
                  ]}
                />
              </a>
            ) : (
              <div class="overflow-hidden shadow-xl">
                <Image
                  src={images[`../assets${poster.image}`].default}
                  alt="Notch event poster"
                  width={poster.width}
                  height={poster.height}
                  class:list={[
                    "w-auto",
                    i < 4 ? "h-88" : "h-92",
                    poster.zoom && "scale-150",
                  ]}
                />
              </div>
            ),
          )
        }
      </div>

      <div
        class="border-primary mx-21 mt-28 flex flex-col items-center gap-18 border-t pt-18"
      >
        <p class="text-statement px-80 text-center">
          Join our newsletter and be the first to hear about exclusive events.
        </p>

        <form
          name="subscribe-events"
          method="POST"
          data-netlify="true"
          class="flex w-100 flex-col gap-1"
        >
          <input type="hidden" name="form-name" value="subscribe-events" />
          <input
            type="email"
            name="email"
            placeholder="Email"
            class="border-primary rounded-sm border px-6 py-4 focus:outline-none"
          />
          <button
            type="submit"
            class="text-primary bg-primary text-secondary hover:text-secondary cursor-pointer rounded-sm py-4 transition-colors duration-200 duration-300 hover:bg-[rgb(101,101,101)]"
            >Sign up</button
          >
        </form>
      </div>
    </div>
  </div>
</Layout>
