---
import Layout from "../layouts/Layout.astro";
import type { Product as ProductType } from "../types";
import Product from "../components/Product.astro";

const products: ProductType[] = [
  {
    name: "FRIEND OF NOTCH",
    descriptionParagraphs: [
      'As a Friend of Notch, you will receive <span class="italic">Issue 002: Gravity</span>, as well as a screen printed tote bag, limited edition baseball cap, and printed acknowledgment in one issue of the magazine.',
      "You'll also have first access to exclusive events in New York and Paris.",
    ],
    price: 250,
    stripeUrl: "https://buy.stripe.com/4gw14g5n1bfmd5C004",
    images: [
      "/donate/friend/1.jpg",
      "/donate/friend/2.jpg",
      "/donate/friend/3.jpg",
    ],
  },
  {
    name: "LIFETIME SUBSCRIPTION",
    descriptionParagraphs: [
      'As a lifetime subscriber, you\'ll receive each issue of <span class="italic">Notch Magazine</span> as well as a screen printed tote bag, limited edition baseball cap, and issuely printed acknowledgment of your generous support.',
      "You'll also have first access to exclusive events in New York and Paris.",
    ],
    price: 1000,
    stripeUrl: "https://buy.stripe.com/eVa28kdTx97efdKdQV",
    images: [
      "/donate/lifetime/1.jpg",
      "/donate/lifetime/2.jpg",
      "/donate/lifetime/3.jpg",
    ],
  },
];
---

<Layout title="support">
  <div class="p-frame max-md:px-8 max-md:pt-38 max-md:pb-12">
    <p
      class="text-statement text-justify max-md:px-6 max-md:text-center max-md:text-3xl"
    >
      Notch Magazine is an independent publication devoted to de-siloing the
      creative arts and publishing ambitious work across all artistic genres.
      Produced by a team of volunteers, Notch remains unaffiliated with any
      gallery or publisher. We sustain our independence through selective
      partnerships and the generosity of our patrons. To support Notch, consider
      becoming a Friend of Notch or a Lifetime Subscriber.
    </p>

    <div
      class="mt-28 mb-36 flex flex-col gap-26 max-md:mt-16 max-md:mb-18 max-md:gap-16"
    >
      {products.map((product, idx) => <Product product={product} idx={idx} />)}
    </div>

    <hr class="border-primary mx-auto mb-14 w-3/4 border-t max-md:w-full" />

    <p class="text-statement px-93 text-center max-md:px-24 max-md:text-3xl">
      Looking to advertise or partner with us? <a
        href="mailto:editors@notch.ink"
        class="hover:text-primary underline decoration-1 underline-offset-8"
        >Email us</a
      > to request our media kit.
    </p>
  </div>
</Layout>
