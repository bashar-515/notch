---
import Layout from "../layouts/Layout.astro";
---

<Layout title="submissions" overlayHeader>
  <div
    class="flex min-h-dvh flex-col items-center justify-center gap-28 px-120"
  >
    <p class="text-statement text-center">
      Submissions are currently closed. Sign up for our newsletter or follow us
      on <a
        href="https://www.instagram.com/notch.magazine/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary underline decoration-1 underline-offset-8"
        >Instagram</a
      > to be notified when submissions reopen.
    </p>

    <form
      name="subscribe-submissions"
      method="POST"
      novalidate
      data-netlify="netlify"
      class="flex w-100 flex-col gap-1"
    >
      <input type="hidden" name="form-name" value="subscribe-submissions" />
      <input
        type="email"
        required
        name="email"
        placeholder="Email"
        class="border-primary rounded-sm border px-6 py-4 focus:outline-none aria-invalid:ring-2 aria-invalid:ring-red-500"
      />
      <button
        type="submit"
        class="text-primary bg-primary text-secondary hover:text-secondary cursor-pointer rounded-sm py-4 transition-colors duration-200 duration-300 hover:bg-[rgb(101,101,101)]"
        >Sign up</button
      >
    </form>
  </div>
</Layout>
